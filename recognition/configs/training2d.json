{
  "run_id": "2d_unet",
  "pipeline": {
    "train": true,
    "predict": true,
    "evaluate": true,
    "test": true,
    "plot": true
  },
  "amp": true,
  "model": {
    "channels": [64, 128, 256, 512, 1024],
    "input_patch_size": [572, 572],
    "output_patch_size": [388, 388]
  },
  "loss": {
    "include_background": false,
    "probability_floor": 1e-07,
    "lambda_dice": 1.0,
    "lambda_ce": 1.0
  },
  "training": {
    "epochs": 30,
    "learning_rate": 0.0005,
    "weight_decay": 1e-05,
    "lr_decay": 0.999,
    "batch_size": 1
  },
  "inference": {
    "partition": "validate",
    "prediction_id": "validation"
  },
  "testing": {
    "prediction_id": "test",
    "figure_id": "test_figures"
  },
  "graphs": {
    "figure_id": "figures",
    "overlay_cases": [],
    "max_overlay_cases": 3,
    "slice_fraction": 0.5,
    "dpi": 140,
    "alpha": 0.4,
    "label_cmap": "tab10",
    "image_cmap": "gray",
    "figure_size": [14, 10],
    "point_size": 12,
    "jitter": 0.08
  }
}
